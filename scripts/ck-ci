#!/usr/bin/env bash
# ck-ci — contextual CI/CD. Detection is per repo (files + remote); no
# platform is assumed: GitHub Actions / GitLab CI, via gh / glab when
# installed, or via the public API with curl (read-only, public GitHub repos).
# Subcommands: detect [-q] | runs | failed | ids | view <id> | rerun <id> | page
set -u

CK_SRC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib/common.sh
source "$CK_SRC_DIR/lib/common.sh"

ck_git_root >/dev/null || { echo "not inside a git repository" >&2; exit 1; }

detect() { # prints provider= ci= cli= repo=owner/name
  local root prov cli ci repo
  root="$(ck_git_root)"
  prov="$(ck_git_provider || true)"
  ci=none
  if ls "$root"/.github/workflows/* >/dev/null 2>&1; then ci=actions
  elif [ -f "$root/.gitlab-ci.yml" ]; then ci=gitlab
  fi
  cli=none
  if [ "$prov" = github ] && ck_have gh; then cli=gh
  elif [ "$prov" = gitlab ] && ck_have glab; then cli=glab
  fi
  repo=""
  if [ -n "$prov" ]; then
    repo="$(ck_git_https | sed 's|.*://[^/]*/||')"  # owner/name
  fi
  echo "provider=${prov:-none} ci=$ci cli=$cli repo=$repo"
}

ci_env() { # loads PROVIDER/CI_SYS/CLI/REPO from detect
  eval "$(detect | tr ' ' '\n' | sed 's/^/D_/')"
  PROVIDER="${D_provider}"; CI_SYS="${D_ci}"; CLI="${D_cli}"; REPO="${D_repo}"
  [ -n "$PROVIDER" ] || PROVIDER=none
}

need_ci() {
  [ "$CI_SYS" != "none" ] || { echo "no CI detected in this repository (.github/workflows or .gitlab-ci.yml)" >&2; exit 1; }
}

ck_gh_public() { # ck_gh_public <path> <jq-expr>  (public API, public repos only)
  local repo; repo="$(ck_git_https | sed 's|.*://[^/]*/||')"
  curl -sf --max-time 8 "https://api.github.com/repos/$repo$1" | jq -r "$2"
}

sub="${1:-detect}"; shift || true
ci_env

case "$sub" in
  detect)
    quiet=0; [ "${1:-}" = "-q" ] && quiet=1
    if [ "$quiet" -eq 1 ]; then detect; else
      out="$(detect)"; echo "$out" | tr ' ' '\n' | sed 's/=/ /;s/^/  /'
      [ "$CLI" != "none" ] || echo "  note: without the CLI ($([ "$PROVIDER" = github ] && echo gh || echo glab)) only limited read access is available"
    fi
    ;;
  runs)
    need_ci
    case "$CLI:$CI_SYS" in
      gh:actions)    exec gh run list --limit 15 ;;
      glab:gitlab)   exec glab ci list -P 15 ;;
      *:actions)     ck_gh_public '/actions/runs?per_page=15' \
                       '.workflow_runs[] | "\(.id)  \(.conclusion // .status)  \(.name)  \(.head_branch // "-")"' ;;
      *) echo "listing unavailable without glab (private repo or missing CLI)" >&2; exit 1 ;;
    esac
    ;;
  failed)
    need_ci
    case "$CLI:$CI_SYS" in
      gh:actions)    exec gh run list --limit 15 --status failure ;;
      glab:gitlab)   exec glab ci list --status failed -P 15 ;;
      *:actions)     ck_gh_public '/actions/runs?per_page=15&status=failure' \
                       '.workflow_runs[] | "\(.id)  \(.name)  \(.head_branch // "-")"' ;;
      *) echo "unavailable without glab" >&2; exit 1 ;;
    esac
    ;;
  ids) # IDs only, for palette pickers
    need_ci
    case "$CLI:$CI_SYS" in
      gh:actions)    gh run list --limit 15 --json databaseId -q '.[].databaseId' ;;
      glab:gitlab)   glab ci list -P 15 | awk 'NR>2 {print $1}' ;;
      *:actions)     ck_gh_public '/actions/runs?per_page=15' '.workflow_runs[].id' ;;
      *) : ;;
    esac
    ;;
  view)
    need_ci; id="${1:?missing run id}"
    case "$CLI:$CI_SYS" in
      gh:actions)    exec gh run view "$id" --log ;;
      glab:gitlab)   exec glab ci trace "$id" ;;
      *) echo "logs require gh (private API)" >&2; exit 1 ;;
    esac
    ;;
  rerun)
    need_ci; id="${1:?missing run id}"
    case "$CLI:$CI_SYS" in
      gh:actions)    exec gh run rerun "$id" ;;
      glab:gitlab)   exec glab ci retry "$id" ;;
      *) echo "retrying requires an authenticated gh/glab" >&2; exit 1 ;;
    esac
    ;;
  page) # web URL for pipelines/runs
    exec "$CK_SRC_DIR/ck-git" url ci
    ;;
  *)
    echo "usage: ck ci detect|runs|failed|ids|view <id>|rerun <id>|page" >&2
    exit 2
    ;;
esac
