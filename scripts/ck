#!/usr/bin/env bash
# ck — terminal cockpit dispatcher (git / k8s / ci / argocd / status / doctor)
# Each module also works standalone: ck-git, ck-k8s, ck-ci, ck-argocd, ck-status
# Usage: ck <group> <subcommand> [args...]   |   ck help
set -u

CK_SRC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib/common.sh
source "$CK_SRC_DIR/lib/common.sh"

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  git|k8s|ci|argocd|status)
    exec "$CK_SRC_DIR/ck-$cmd" "$@"
    ;;
  doctor)
    quiet=0
    for a in "$@"; do [ "$a" = "-q" ] && quiet=1; done
    if [ "$quiet" -eq 1 ]; then
      for t in git kubectl k3s gh glab argocd jq curl; do
        if ck_have "$t"; then printf '%s=1 ' "$t"; else printf '%s=0 ' "$t"; fi
      done
      echo
    else
      echo "cockpit environment (WSL):"
      for t in git kubectl k3s gh glab argocd jq curl; do
        if ck_have "$t"; then
          printf '  %-8s %s✓%s %s\n' "$t" "$CK_C_G" "$CK_C_0" "$(command -v "$t")"
        else
          printf '  %-8s %s✗%s not installed\n' "$t" "$CK_C_R" "$CK_C_0"
        fi
      done
    fi
    ;;
  palette)
    # one-shot context for the WezTerm palette: caps + repo + provider + CI.
    # Local operations only (no network) so it is fast; run it in the pane cwd.
    caps=""
    for t in git kubectl k3s gh glab argocd jq curl; do
      if ck_have "$t"; then caps="$caps$t=1 "; else caps="$caps$t=0 "; fi
    done
    inrepo=0 prov="none" url="" ci=none
    if ck_have git && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      inrepo=1
      p="$(ck_git_provider || true)"
      [ -n "$p" ] && prov="$p"
      url="$(ck_git_https || true)"
      root="$(ck_git_root)"
      if ls "$root"/.github/workflows/* >/dev/null 2>&1; then ci=actions
      elif [ -f "$root/.gitlab-ci.yml" ]; then ci=gitlab
      fi
    fi
    echo "ctx_pwd=$PWD $caps in_repo=$inrepo provider=$prov url=$url ci=$ci"
    ;;
  help|*)
    cat <<'EOF'
ck — terminal cockpit (WezTerm + Starship)

  ck git info                  repository, branch, ahead/behind, dirty
  ck git branches              local branches (for pickers)
  ck git url repo|pulls|ci     web URL based on the remote provider
  ck git provider              detected provider (github/gitlab)
  ck k8s contexts|namespaces|pods|deployments|services|events [--names] [ns]
  ck ci detect [-q]|runs|failed|view <id>|rerun <id>|page
  ck argocd detect [-q]|apps|names|get|sync|refresh|history|logs <app>
  ck status [--force] [--quiet]  refresh the state rendered by WezTerm
  ck doctor [-q]                detected tools
EOF
    ;;
esac
