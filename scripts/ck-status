#!/usr/bin/env bash
# ck-status — refreshes cockpit state (k8s context, API, ArgoCD) and writes it
# to ~/.cache/terminal-cockpit/state so WezTerm can render it without
# spawning any process (avoids hangs when the API is down).
# Usage: ck-status [--force] [--quiet]
set -u

CK_SRC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib/common.sh
source "$CK_SRC_DIR/lib/common.sh"

force=0 quiet=0
for a in "$@"; do
  case "$a" in
    --force|-f) force=1 ;;
    --quiet|-q) quiet=1 ;;
  esac
done

# --- global throttle: at most once every 30 s (unless --force) ---
if [ "$force" -eq 0 ] && ! ck_throttled status_checked 30; then
  exit 0
fi
ck_state_set status_checked "$(ck_now)"

# --- context and namespace (offline: kubeconfig only) ---
ctx="" ns=""
if ck_have kubectl; then
  ctx="$(timeout 3 kubectl config current-context 2>/dev/null || true)"
  ns="$(timeout 3 kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null || true)"
fi
if [ -z "$ctx" ] && [ -r "${KUBECONFIG:-$HOME/.kube/config}" ]; then
  # cheap fallback when the k3s kubectl is slow to start
  ctx="$(sed -n 's/^current-context:[[:space:]]*//p' "${KUBECONFIG:-$HOME/.kube/config}" | head -1)"
fi
[ -z "$ns" ] && ns="default"
ck_state_set k8s_context "$ctx"
ck_state_set k8s_namespace "$ns"

# --- API reachability (own throttle) ---
if ! ck_have kubectl; then
  ck_state_set k8s_state none
else
  if [ "$force" -eq 1 ] || ck_throttled api_checked "$CK_API_EVERY"; then
    ck_state_set api_checked "$(ck_now)"
    if timeout "$CK_API_TIMEOUT" kubectl get --raw /readyz >/dev/null 2>&1; then
      ck_state_set k8s_state ok
    else
      ck_state_set k8s_state down
    fi
    # Is ArgoCD installed in the cluster? (applications CRD)
    if [ "$(ck_state_get k8s_state)" = "ok" ]; then
      if ck_kubectl get crd applications.argoproj.io >/dev/null 2>&1; then
        ck_state_set argocd_kube 1
      else
        ck_state_set argocd_kube 0
      fi
    fi
  fi
fi

# --- ArgoCD CLI (own throttle) ---
if [ "$force" -eq 1 ] || ck_throttled argo_checked "$CK_ARGO_EVERY"; then
  ck_state_set argo_checked "$(ck_now)"
  if ! ck_have argocd; then
    ck_state_set argocd absent
  elif timeout "$CK_API_TIMEOUT" argocd context >/dev/null 2>&1; then
    ck_state_set argocd ready
  else
    ck_state_set argocd error
  fi
fi

ck_state_set updated "$(ck_now)"

# --- human output ---
if [ "$quiet" -ne 1 ]; then
  st="$(ck_state_get k8s_state)"
  case "$st" in
    ok)   st="${CK_C_G}ok${CK_C_0}" ;;
    down) st="${CK_C_R}down${CK_C_0}" ;;
    *)    st="${CK_C_Y}${st}${CK_C_0}" ;;
  esac
  echo "k8s  context: ${CK_C_B}${ctx}${CK_C_0} · ns: ${CK_C_B}${ns}${CK_C_0} · API: ${st}"
  ar="$(ck_state_get argocd)"; ark="$(ck_state_get argocd_kube)"
  echo "argo CLI: ${ar:-?} · in cluster: ${ark:-?}"
  echo "state → $CK_STATE_FILE"
fi
